{
  "rewrites": [
    {
      "source": "/api/auth/google/:path*",
      "destination": "https://findfooddelivery-backend.onrender.com/auth/google/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-H2jGG7PaaJV/E7t5A4HFrxKwWZFb9G2qOMXt++VZBnQ=' 'sha256-LQOS+6jAXsURwb/i+pK/MPmBCf8ZPeivhS1ZT1otXY4=' 'sha256-DztRBG/SnObRaua0nCfReLmsDxmoVRezUVVpxNFuEbg=' 'sha256-ym/Jc6Uydh1Hha0O6/9k+mdlCBE6x5V4H/VYJ4CYYTQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://findfooddelivery-backend.onrender.com https://res.cloudinary.com https://*.googleusercontent.com https://tiles.openfreemap.org; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' blob: data: https://findfooddelivery-backend.onrender.com wss://findfooddelivery-backend.onrender.com https://fonts.gstatic.com https://res.cloudinary.com https://*.googleusercontent.com https://tiles.openfreemap.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/canvaskit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/maplibre/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/maplibre/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(AssetManifest.json|AssetManifest.bin|AssetManifest.bin.json|FontManifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
